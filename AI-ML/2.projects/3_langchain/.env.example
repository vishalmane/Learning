# Copy this file to .env and fill in your Gemini API key from Google AI Studio.
GOOGLE_API_KEY=
# GEMINI_API_KEY also works as a fallback for the LangChain Google GenAI package.
# GEMINI_API_KEY=

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain-lab

# Defaults used by examples and UI.
LC_LAB_MODEL=gemini-2.5-flash
LC_LAB_EMBEDDING_MODEL=gemini-embedding-2-preview
LC_LAB_TEMPERATURE=0.2

# The Streamlit UI starts in Demo mode by default and can switch to Live Gemini.
# Examples in ./examples call the live provider directly.
