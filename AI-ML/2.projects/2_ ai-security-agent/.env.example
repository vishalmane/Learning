APP_NAME=ai-security-agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

DATABASE_URL=sqlite:///./app/database/ai_security_agent.db
OPENAI_API_KEY=your_openai_api_key_here

CAMERA_SOURCE=0
CAMERA_TARGET_FPS=8
FACE_DETECTION_BACKEND=opencv
FACE_DETECTION_INTERVAL=30
FACE_RECOGNITION_MODEL=Facenet
FACE_MATCH_THRESHOLD=0.65
KNOWN_FACES_DIR=./app/data/known_faces
FACE_EMBEDDINGS_PATH=./app/data/known_face_embeddings.json

ALERT_EMAIL_FROM=security@example.com
ALERT_EMAIL_TO=admin@example.com
ALERT_WEBHOOK_URL=
